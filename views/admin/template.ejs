<%- include('../partials/head') %>
<div class="page-head"><h1>صيغة العقد</h1></div>
<%- include('../partials/admin-nav') %>
<div class="card row">
  <strong>الصيغة الخاصة بـ:</strong>
  <select onchange="location.href = '/admin/template' + (this.value ? '?company=' + this.value : '')" style="max-width:320px">
    <option value="">الصيغة العامة (لكل الشركات بدون صيغة خاصة)</option>
    <% companies.forEach(c => { %><option value="<%= c.id %>" <%= company && company.id === c.id ? 'selected' : '' %>><%= c.name %><%= c.contract_template ? ' — صيغة خاصة' : '' %></option><% }) %>
  </select>
  <% if (usesGeneral) { %><span class="muted">هذه الشركة تستخدم الصيغة العامة حالياً — أي حفظ هنا ينشئ لها صيغة خاصة.</span><% } %>
</div>

<div class="grid grid-2">
  <div class="card">
    <h2>استيراد العقد من ملف Word</h2>
    <form method="post" action="/admin/template/docx" enctype="multipart/form-data">
      <% if (company) { %><input type="hidden" name="company_id" value="<%= company.id %>"><% } %>
      <div class="field"><input type="file" name="docx" accept=".docx" required></div>
      <p class="hint">اكتب داخل ملف الـ Word الأماكن المتغيرة بين قوسين مزدوجين، مثلاً <span class="ltr">{{client_name}}</span> مكان اسم العميل و <span class="ltr">{{client_signature}}</span> مكان توقيع العميل. أو استورد الملف كما هو ثم أضف الأماكن من المحرر.</p>
      <button class="btn" type="submit" onclick="return confirm('سيتم استبدال الصيغة الحالية. متابعة؟')">استيراد</button>
    </form>
  </div>
  <div class="card">
    <h2>طريقة الاستخدام</h2>
    <ul style="margin:0;padding-inline-start:18px">
      <li>ضع المؤشر في مكان داخل العقد ثم اضغط على أي بيان من القائمة لإدراجه.</li>
      <li><b>مكان توقيع العميل / الشركة</b> يمكن تكراره أكثر من مرة (مثلاً في نهاية كل صفحة)، وسيظهر نفس التوقيع في كل الأماكن.</li>
      <li><b>جدول الأقساط</b> يُدرج جدولاً كاملاً بالمقدم والأقساط والجراج والصيانة.</li>
      <li>التعديل يطبق على العقود الجديدة فقط؛ العقود السابقة تحتفظ بصيغتها.</li>
    </ul>
  </div>
</div>

<form method="post" action="/admin/template" id="tpl-form">
  <% if (company) { %><input type="hidden" name="company_id" value="<%= company.id %>"><% } %>
  <div class="grid" style="grid-template-columns: minmax(0, 1fr) 280px; align-items:start">
    <div>
      <div class="editor-toolbar">
        <button type="button" data-cmd="bold"><b>B</b></button>
        <button type="button" data-cmd="underline"><u>U</u></button>
        <button type="button" data-cmd="formatBlock" data-arg="h1">عنوان كبير</button>
        <button type="button" data-cmd="formatBlock" data-arg="h3">عنوان بند</button>
        <button type="button" data-cmd="formatBlock" data-arg="p">فقرة</button>
        <button type="button" data-cmd="justifyCenter">توسيط</button>
        <button type="button" data-cmd="justifyRight">يمين</button>
        <button type="button" data-cmd="insertUnorderedList">• قائمة</button>
        <button type="button" data-cmd="insertOrderedList">1. قائمة</button>
        <button type="button" id="toggle-html">HTML</button>
      </div>
      <div class="editor contract-body" id="editor" contenteditable="true"><%- template %></div>
      <textarea id="html" style="display:none;min-height:500px;direction:ltr;font-family:monospace;font-size:13px;border-radius:0 0 8px 8px"></textarea>
      <input type="hidden" name="template" id="template">
      <div class="row" style="margin-top:12px">
        <button class="btn btn-lg" type="submit">حفظ الصيغة</button>
        <% if (company) { %>
          <% if (!usesGeneral) { %><button class="btn btn-light" type="submit" name="reset" value="1" onclick="return confirm('حذف الصيغة الخاصة واستخدام الصيغة العامة؟')">استخدام الصيغة العامة</button><% } %>
        <% } else { %>
          <button class="btn btn-light" type="submit" name="reset" value="1" onclick="return confirm('استرجاع الصيغة المبدئية؟')">استرجاع الصيغة المبدئية</button>
        <% } %>
      </div>
    </div>
    <div class="card" style="position:sticky;top:76px;max-height:80vh;overflow:auto">
      <h3>إدراج بيان</h3>
      <div class="placeholders" style="columns:1">
        <% placeholders.forEach(([key, label]) => { %>
        <button type="button" data-ph="<%= key %>"><%= label %><br><code>{{<%= key %>}}</code></button>
        <% }) %>
      </div>
    </div>
  </div>
</form>

<script>
(function () {
  const editor = document.getElementById('editor');
  const html = document.getElementById('html');
  let htmlMode = false;
  let savedRange = null;
  document.addEventListener('selectionchange', () => {
    const sel = window.getSelection();
    if (sel.rangeCount && editor.contains(sel.anchorNode)) savedRange = sel.getRangeAt(0).cloneRange();
  });
  document.querySelectorAll('[data-cmd]').forEach((b) => b.addEventListener('click', () => {
    editor.focus();
    document.execCommand(b.dataset.cmd, false, b.dataset.arg ? `<${b.dataset.arg}>` : null);
  }));
  document.querySelectorAll('[data-ph]').forEach((b) => b.addEventListener('click', () => {
    const text = `{{${b.dataset.ph}}}`;
    if (htmlMode) {
      const p = html.selectionStart;
      html.value = html.value.slice(0, p) + text + html.value.slice(html.selectionEnd);
      html.focus();
      html.selectionStart = html.selectionEnd = p + text.length;
      return;
    }
    editor.focus();
    if (savedRange) { const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(savedRange); }
    document.execCommand('insertText', false, text);
  }));
  document.getElementById('toggle-html').addEventListener('click', () => {
    htmlMode = !htmlMode;
    if (htmlMode) { html.value = editor.innerHTML; }
    else { editor.innerHTML = html.value; }
    editor.style.display = htmlMode ? 'none' : '';
    html.style.display = htmlMode ? '' : 'none';
  });
  document.getElementById('tpl-form').addEventListener('submit', () => {
    document.getElementById('template').value = htmlMode ? html.value : editor.innerHTML;
  });
})();
</script>
<%- include('../partials/foot') %>
