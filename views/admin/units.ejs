<%- include('../partials/head') %>
<div class="page-head"><h1>الوحدات والأسعار</h1>
  <div class="row"><a class="btn btn-light" href="/admin/units/export.csv">⬇️ تصدير Excel (CSV)</a></div>
</div>
<%- include('../partials/admin-nav') %>

<div class="grid grid-2">
  <div class="card" id="bulk">
    <h2>تسعير جماعي</h2>
    <form method="post" action="/admin/units/bulk-price">
      <div class="grid grid-3">
        <% if (companies.length > 1) { %><div class="field"><label>الشركة</label><select name="company_id"><option value="">الكل</option><% companies.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div><% } %>
        <div class="field"><label>العمارة</label><select name="building"><option value="">الكل</option><% buildings.forEach(b => { %><option><%= b %></option><% }) %></select></div>
        <div class="field"><label>الدور</label><select name="floor"><option value="">الكل</option><% Object.entries(floors).forEach(([k, l]) => { %><option value="<%= k %>"><%= l %></option><% }) %></select></div>
        <div class="field"><label>النموذج</label><input type="text" name="model_no" placeholder="الكل"></div>
        <div class="field"><label>سعر المتر</label><input type="number" name="price_per_m2" step="1" min="0"></div>
        <div class="field"><label>سعر متر الحديقة</label><input type="number" name="garden_price_per_m2" step="1" min="0" placeholder="0"></div>
        <div class="field"><label>مبلغ إضافي ثابت</label><input type="number" name="fixed_amount" step="1" placeholder="0"></div>
        <div class="field"><label>سعر الجراج <span class="hint">(فارغ = بدون تغيير)</span></label><input type="number" name="garage_price" step="1" min="0"></div>
      </div>
      <label class="check" style="margin-bottom:12px"><input type="checkbox" name="only_unpriced" value="1"> الوحدات غير المسعّرة فقط</label>
      <p class="hint">السعر = المساحة × سعر المتر + مساحة الحديقة × سعر متر الحديقة + المبلغ الثابت. الوحدات المباعة لا تتأثر.</p>
      <button class="btn" type="submit" onclick="return confirm('سيتم تحديث أسعار كل الوحدات المطابقة للفلتر. متابعة؟')">تطبيق</button>
    </form>
  </div>
  <div class="card">
    <h2>استيراد من ملف Excel (CSV)</h2>
    <form method="post" action="/admin/units/import" enctype="multipart/form-data">
      <div class="field"><label>الشركة المالكة للوحدات</label><select name="company_id"><% companies.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
      <div class="field"><input type="file" name="csv" accept=".csv,text/csv" required></div>
      <p class="hint">نفس شكل الجدول المرسل: <span class="ltr">MODEL NO., FLOOR, CODE, AREA, GARDEN AREA</span> ويمكن إضافة أعمدة اختيارية: <span class="ltr">ROOMS, BATHROOMS, PRICE, STATUS</span>.
        الوحدات الموجودة يتم تحديثها بنفس الكود، والجديدة تتم إضافتها. احفظ ملف Excel بصيغة CSV UTF-8.</p>
      <button class="btn" type="submit">استيراد</button>
    </form>
  </div>
</div>

<div class="card">
  <h2>نقل وحدات إلى شركة</h2>
  <form method="post" action="/admin/units/assign-company" class="grid grid-4" style="align-items:end">
    <div class="field"><label>العمارة</label><select name="building"><option value="">الكل</option><% buildings.forEach(b => { %><option><%= b %></option><% }) %></select></div>
    <div class="field"><label>الدور</label><select name="floor"><option value="">الكل</option><% Object.entries(floors).forEach(([k, l]) => { %><option value="<%= k %>"><%= l %></option><% }) %></select></div>
    <div class="field"><label>إلى الشركة</label><select name="target_company_id" required><% companies.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
    <div class="field"><button class="btn" type="submit" onclick="return confirm('نقل كل الوحدات المطابقة للشركة المختارة؟')">نقل</button></div>
  </form>
</div>

<div class="card">
  <div class="row no-print" style="margin-bottom:12px">
    <input type="text" id="q" placeholder="بحث بالكود أو النموذج" style="max-width:220px">
    <select id="fb" style="max-width:150px"><option value="">كل العماير</option><% buildings.forEach(b => { %><option><%= b %></option><% }) %></select>
    <select id="ff" style="max-width:150px"><option value="">كل الأدوار</option><% Object.entries(floors).forEach(([k, l]) => { %><option value="<%= k %>"><%= l %></option><% }) %></select>
    <% if (companies.length > 1) { %><select id="fc" style="max-width:180px"><option value="">كل الشركات</option><% companies.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select><% } %>
    <select id="fs" style="max-width:150px"><option value="">كل الحالات</option><% Object.entries(f.STATUS_LABELS).forEach(([k, l]) => { %><option value="<%= k %>"><%= l %></option><% }) %></select>
    <span class="spacer"></span><span class="muted" id="count"></span>
  </div>
  <div class="table-wrap">
  <table class="table responsive" id="units">
    <thead><tr><th>الكود</th><th>الشركة</th><th>العمارة</th><th>الدور</th><th>النموذج</th><th>المساحة</th><th>الحديقة</th><th>الغرف</th><th>السعر</th><th>الجراج</th><th>الحالة</th><th></th></tr></thead>
    <tbody>
    <% units.forEach(u => { %>
      <tr id="u<%= u.id %>" data-b="<%= u.building %>" data-f="<%= u.floor %>" data-s="<%= u.status %>" data-c="<%= u.company_id %>" data-unit="<%= JSON.stringify({ id: u.id, code: u.code, area: u.area, garden_area: u.garden_area, rooms: u.rooms ?? '', own_rooms: u.own_rooms ?? '', bathrooms: u.own_bathrooms ?? '', model_bathrooms: u.model_bathrooms ?? '', price: u.price ?? '', garage_price: u.garage_price ?? '', status: u.status, notes: u.notes || '', image: u.own_image, company_id: u.company_id }) %>">
        <td class="ltr"><b><%= u.code %></b></td><td><%= u.company_name || '—' %></td><td><%= u.building %></td><td><%= f.floorLabel(u.floor) %></td><td><%= u.model_no || '—' %></td>
        <td class="num"><%= f.area(u.area) %></td><td class="num"><%= u.garden_area ? f.area(u.garden_area) : '—' %></td><td><%= u.rooms ?? '—' %></td>
        <td class="num"><%= u.price ? f.money(u.price) : '<span style="color:var(--danger)">—</span>' %></td>
        <td class="num"><%= u.garage_price != null ? f.money(u.garage_price) : '<span class="muted">افتراضي</span>' %></td>
        <td><span class="badge badge-<%= u.status %>"><%= f.STATUS_LABELS[u.status] %></span></td>
        <td><button class="btn btn-sm btn-light" type="button" onclick="editUnit(this)">تعديل</button></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<dialog id="unit-dialog" style="border:none;border-radius:12px;padding:0;max-width:640px;width:95%">
  <form method="post" enctype="multipart/form-data" id="unit-form" class="card" style="margin:0">
    <h2>تعديل الوحدة <span class="ltr" id="d-code"></span></h2>
    <div class="grid grid-3">
      <div class="field"><label>المساحة م²</label><input type="number" step="0.01" name="area" required></div>
      <div class="field"><label>مساحة الحديقة م²</label><input type="number" step="0.01" name="garden_area"></div>
      <div class="field"><label>الشركة</label><select name="company_id"><% companies.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div>
      <div class="field"><label>الحالة</label><select name="status"><% Object.entries(f.STATUS_LABELS).forEach(([k, l]) => { %><option value="<%= k %>"><%= l %></option><% }) %></select></div>
      <div class="field"><label>السعر ج.م</label><input type="number" step="1" name="price"></div>
      <div class="field"><label>سعر الجراج <span class="hint">(فارغ = الافتراضي)</span></label><input type="number" step="1" name="garage_price"></div>
      <div class="field"><label>عدد الغرف <span class="hint">(فارغ = من النموذج)</span></label><input type="number" step="1" name="rooms"></div>
      <div class="field"><label>الحمامات <span class="hint">(فارغ = من النموذج)</span></label><input type="number" step="1" name="bathrooms"></div>
      <div class="field" style="grid-column: span 2"><label>صورة خاصة بالوحدة <span class="hint">(اختياري — بدلاً من صورة النموذج)</span></label><input type="file" name="image" accept="image/*"></div>
    </div>
    <label class="check" id="d-remove" style="margin-bottom:10px"><input type="checkbox" name="remove_image" value="1"> حذف الصورة الخاصة بالوحدة</label>
    <div class="field"><label>ملاحظات</label><textarea name="notes" style="min-height:60px"></textarea></div>
    <div class="row"><button class="btn" type="submit">حفظ</button><button class="btn btn-light" type="button" onclick="document.getElementById('unit-dialog').close()">إلغاء</button></div>
  </form>
</dialog>

<script>
function editUnit(btn) {
  const u = JSON.parse(btn.closest('tr').dataset.unit);
  const form = document.getElementById('unit-form');
  form.action = '/admin/units/' + u.id;
  document.getElementById('d-code').textContent = u.code;
  for (const k of ['area', 'garden_area', 'bathrooms', 'price', 'garage_price', 'status', 'notes', 'company_id']) form.elements[k].value = u[k];
  form.elements.rooms.value = u.own_rooms;
  form.elements.rooms.placeholder = u.rooms;
  form.elements.bathrooms.placeholder = u.model_bathrooms;
  form.elements.remove_image.checked = false;
  document.getElementById('d-remove').style.display = u.image ? '' : 'none';
  document.getElementById('unit-dialog').showModal();
}
(function () {
  const rows = [...document.querySelectorAll('#units tbody tr')];
  const els = ['q', 'fb', 'ff', 'fs', 'fc'].map((id) => document.getElementById(id) || { value: '', addEventListener() {} });
  function apply() {
    const [q, b, fl, s, c] = els.map((e) => e.value.trim().toLowerCase());
    let n = 0;
    rows.forEach((tr) => {
      const show = (!q || tr.textContent.toLowerCase().includes(q)) && (!b || tr.dataset.b.toLowerCase() === b)
        && (!fl || tr.dataset.f.toLowerCase() === fl) && (!s || tr.dataset.s === s) && (!c || tr.dataset.c === c);
      tr.style.display = show ? '' : 'none';
      if (show) n++;
    });
    document.getElementById('count').textContent = n + ' وحدة';
  }
  els.forEach((e) => e.addEventListener('input', apply));
  apply();
})();
</script>
<%- include('../partials/foot') %>
