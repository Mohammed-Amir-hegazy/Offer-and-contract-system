<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>عقد <%= contract.number %> — <%= contract.client.name %> — <%= company.name %></title>
<link rel="icon" href="<%= company.logo ? f.upload(company.logo) : '/img/favicon.svg' %>">
<link rel="stylesheet" href="/css/style.css">
</head>
<body style="background:#fff">
<div class="actions-bar" style="margin-top:16px"><button class="btn" onclick="window.print()">🖨️ طباعة / حفظ PDF</button></div>
<%- include('partials/company-style') %>
<div class="doc<%= body.includes('contract-page') ? ' paged' : '' %>" style="border:none;box-shadow:none">
  <%- include('partials/contract-letterhead') %>
  <div class="contract-body"><%- body %></div>
  <% if (contract.status === 'signed') { %>
  <div class="doc-foot<%= body.includes('contract-page') ? ' no-print' : '' %>">
    تم توقيع هذا العقد إلكترونياً — العميل: <%= contract.client_signer_name %> (<%= f.datetime(contract.client_signed_at) %>) —
    الشركة: <%= contract.company_signer_name %> (<%= f.datetime(contract.company_signed_at) %>)
    <% if (contract.body_hash) { %><br>بصمة العقد: <span class="ltr"><%= contract.body_hash.slice(0, 32) %></span><% } %>
  </div>
  <% } %>
</div>
</body>
</html>
