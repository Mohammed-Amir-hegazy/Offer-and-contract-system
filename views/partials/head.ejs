<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> — <%= settings.company_name %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap">
<link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<% if (user) { %>
<header class="topbar">
  <div class="inner">
    <a class="brand" href="/">
      <% if (settings.company_logo) { %><img src="/uploads/<%= settings.company_logo %>" alt=""><% } %>
      <%= settings.company_name %>
    </a>
    <nav class="nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">الرئيسية</a>
      <% if (user.role === 'admin' || user.can_quote) { %><a href="/quotes" class="<%= path.startsWith('/quotes') ? 'active' : '' %>">عروض الأسعار</a><% } %>
      <% if (user.role === 'admin' || user.can_contract) { %><a href="/contracts" class="<%= path.startsWith('/contracts') ? 'active' : '' %>">العقود</a><% } %>
      <% if (user.role === 'admin') { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">لوحة الأدمن</a><% } %>
    </nav>
    <div class="userbox">
      <a href="/account/password" style="color:#fff"><%= user.full_name %></a>
      <form method="post" action="/logout"><button type="submit">خروج</button></form>
    </div>
  </div>
</header>
<% } %>
<main>
<% if (flash) { %><div class="alert alert-<%= flash.type %> flash"><%= flash.message %></div><% } %>
