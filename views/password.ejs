<%- include('partials/head') %>
<div class="card" style="max-width:460px;margin:20px auto">
  <h1>تغيير كلمة المرور</h1>
  <% if (user.must_change_password) { %><div class="alert alert-warning">برجاء اختيار كلمة مرور جديدة قبل المتابعة</div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post">
    <div class="field"><label>كلمة المرور الحالية</label><input type="password" name="current" autocomplete="current-password" required></div>
    <div class="field"><label>كلمة المرور الجديدة <span class="hint">(8 أحرف على الأقل)</span></label><input type="password" name="password" autocomplete="new-password" minlength="8" required></div>
    <div class="field"><label>تأكيد كلمة المرور</label><input type="password" name="confirm" autocomplete="new-password" required></div>
    <button class="btn" type="submit">حفظ</button>
  </form>
</div>
<%- include('partials/foot') %>
